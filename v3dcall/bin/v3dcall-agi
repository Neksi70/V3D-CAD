#!/usr/bin/env python3
"""Fuehrt das Telefongespraech — laeuft in Asterisk als AGI-Skript.

Bewusst nur Standardbibliothek: das Skript laeuft als Benutzer 'asterisk',
und /home/v3da ist fuer den nicht lesbar. Alles Schwere (Whisper, Claude,
ElevenLabs) macht der V3D-Dienst auf 127.0.0.1:8786.
"""
import json
import os
import random
import sys
import threading
import urllib.request

DIENST = "http://127.0.0.1:8786"
SPOOL = "/var/spool/v3dcall"
# Der Token liegt in /etc/v3dcall.token (root:asterisk, 0640). Im Betrieb
# laeuft dieses Skript als asterisk und darf ihn lesen. Die Umgebungsvariable
# ist nur fuer Tests von der Kommandozeile aus.
TOKEN = os.environ.get("V3DCALL_TOKEN", "")
if not TOKEN:
    try:
        with open("/etc/v3dcall.token") as fh:
            TOKEN = fh.read().strip()
    except Exception:
        pass


# --------------------------------------------------------------- AGI-Grundlagen

def agi(befehl):
    """Befehl an Asterisk schicken und Ergebniszeile zurueckgeben."""
    sys.stdout.write(befehl + "\n")
    sys.stdout.flush()
    antwort = sys.stdin.readline().strip()
    return antwort


def ergebnis(zeile):
    """'200 result=-1' -> -1 ; -1 heisst hier: Anrufer hat aufgelegt."""
    for teil in zeile.split():
        if teil.startswith("result="):
            wert = teil.split("=", 1)[1].strip("()")
            try:
                return int(wert)
            except ValueError:
                return 0
    return 0


PROTOKOLL = "/var/spool/v3dcall/agi.log"
# Aufnahmen unter dieser Groesse gelten als kurze Bestaetigung.
# 8 kHz mono 16 bit = 16000 Bytes je Sekunde.
KURZ_GRENZE = @@KURZGRENZE@@
# Darunter ist es praktisch Stille: reine Stille wird von Asterisk auf
# rund eine Sekunde zusammengeschnitten, das sind ~16 kB.
STILLE_GRENZE = 20000


def sag(text):
    """VERBOSE landet nicht im Standardprotokoll von Asterisk — deshalb
    zusaetzlich in eine eigene Datei, sonst ist jede Stoerung unsichtbar."""
    agi('VERBOSE "%s" 1' % text.replace('"', "'"))
    try:
        import time as _t
        with open(PROTOKOLL, "a") as fh:
            fh.write("%s  %s\n" % (_t.strftime("%H:%M:%S"), text))
    except Exception:
        pass


def spiele(datei_ohne_endung):
    """Datei abspielen. Liefert False, wenn aufgelegt wurde.

    Vorher pruefen, ob es die Datei ueberhaupt gibt: STREAM FILE meldet bei
    einer fehlenden Datei ebenfalls -1, und das ist nicht von "der Anrufer
    hat aufgelegt" zu unterscheiden. Genau daran ist ein Gespraech gescheitert.
    """
    if not any(os.path.exists(datei_ohne_endung + e)
               for e in (".wav", ".gsm", ".ulaw", ".alaw", ".sln")):
        sag("Ansage fehlt: %s" % datei_ohne_endung)
        return True
    return ergebnis(agi('STREAM FILE %s ""' % datei_ohne_endung)) != -1


def nimm_auf(ziel_ohne_endung, max_sekunden, stille_sekunden):
    agi("RECORD FILE %s wav \"\" %d 0 s=%d"
        % (ziel_ohne_endung, max_sekunden * 1000, stille_sekunden))
    return ziel_ohne_endung + ".wav"


def hole(pfad, nutzlast):
    daten = json.dumps(nutzlast).encode()
    anfrage = urllib.request.Request(
        DIENST + pfad, data=daten,
        headers={"Content-Type": "application/json", "X-V3D-Notify": TOKEN})
    with urllib.request.urlopen(anfrage, timeout=60) as r:
        return json.loads(r.read().decode())


def _still(fn):
    try:
        fn()
    except Exception:
        pass


def rueckfall(cid):
    """Wenn das Gespraech nicht laeuft, wenigstens eine Nachricht aufnehmen.

    Ein Anrufer, der wegen eines Ausfalls einfach abgewuergt wird, ist
    schlimmer als gar kein Assistent. Darum hier der klassische
    Anrufbeantworter als Netz.
    """
    sag("V3D faellt auf den Anrufbeantworter zurueck")
    if not spiele("/var/lib/asterisk/sounds/v3d/stoerung"):
        return
    if not spiele("/var/lib/asterisk/sounds/v3d/beep"):
        return
    nimm_auf("%s/%s" % (SPOOL, cid), 180, 4)
    spiele("/var/lib/asterisk/sounds/v3d/danke")
    agi("HANGUP")


# ------------------------------------------------------------------- Ablauf

def main():
    # Asterisk schickt die Kanaldaten, abgeschlossen von einer Leerzeile
    umgebung = {}
    while True:
        zeile = sys.stdin.readline().strip()
        if not zeile:
            break
        if ":" in zeile:
            k, v = zeile.split(":", 1)
            umgebung[k.strip()] = v.strip()

    cid = umgebung.get("agi_uniqueid", "unbekannt")
    max_runden = int(sys.argv[1]) if len(sys.argv) > 1 else 12
    max_sek = int(sys.argv[2]) if len(sys.argv) > 2 else 30
    stille = int(sys.argv[3]) if len(sys.argv) > 3 else 2

    agi("ANSWER")
    # Kurze Pause, damit der Anfang der Begruessung nicht abgeschnitten wird.
    # Eine ganze Sekunde ist zu viel — der Anrufer wartet ohnehin schon.
    agi("EXEC Wait 0.4")

    # Eine der neun Begruessungen, zufaellig — wer zweimal anruft, soll nicht
    # zweimal denselben Spruch hoeren.
    # Waehrend die Begruessung laeuft, im Hintergrund den Zwischenspeicher
    # fuellen. Spart bei der ERSTEN Antwort rund zwei Sekunden — die
    # Begruessung dauert ohnehin elf.
    threading.Thread(target=lambda: _still(
        lambda: hole("/api/dialog/vorwaermen", {})), daemon=True).start()

    gruesse = [g for g in range(1, 10)
               if os.path.exists("/var/lib/asterisk/sounds/v3d/gruss%d.wav" % g)]
    if gruesse:
        if not spiele("/var/lib/asterisk/sounds/v3d/gruss%d" % random.choice(gruesse)):
            return
    elif not spiele("/var/lib/asterisk/sounds/v3d/dialog-begruessung"):
        return
    # Kurzer Ton: ohne ihn weiss der Anrufer nicht, ab wann zugehoert wird,
    # zoegert — und die Stilleerkennung beendet die Aufnahme, bevor er
    # angefangen hat.
    if not spiele("/var/lib/asterisk/sounds/v3d/beep"):
        return

    leer_hintereinander = 0
    zoegern_hintereinander = 0
    for runde in range(1, max_runden + 1):
        aufnahme = nimm_auf("%s/%s-r%d" % (SPOOL, cid, runde), max_sek, stille)
        if not os.path.exists(aufnahme) or os.path.getsize(aufnahme) < 2000:
            # Gar nichts aufgenommen. Beim ersten Mal still nochmal zuhoeren,
            # erst danach nachfragen — vielleicht sammelt sich der Anrufer nur.
            leer_hintereinander += 1
            if leer_hintereinander >= 3:
                break
            if leer_hintereinander > 1 and not spiele(
                    "/var/lib/asterisk/sounds/v3d/nachfrage"):
                return
            continue

        # Fuellwort und Verarbeitung laufen GLEICHZEITIG. Nacheinander wuerde
        # das Fuellwort die Wartezeit um seine eigene Laenge verlaengern,
        # statt sie zu ueberbruecken — es soll die Denkpause fuellen, nicht
        # vor ihr liegen.
        kasten = {}

        def arbeite():
            try:
                kasten["antwort"] = hole("/api/dialog",
                    {"id": cid, "runde": str(runde), "file": aufnahme,
                     "caller": umgebung.get("agi_callerid", "")})
            except Exception as e:
                kasten["fehler"] = e

        faden = threading.Thread(target=arbeite)
        faden.start()

        # Kurze Aeusserung ("ja danke", "passt", "bitte") braucht kein
        # Nachdenk-Fuellwort — darauf gehoert ein knappes "Okay.". Die Laenge
        # der Aufnahme verraet den Unterschied, bevor wir wissen, was gesagt
        # wurde: das Fuellwort laeuft ja parallel zur Verarbeitung.
        # Welches Fuellwort passt, weiss man erst nach der Erkennung — die
        # laeuft aber parallel. Also entscheiden wir aus dem, was VORHER
        # bekannt ist: Rundennummer und Laenge der Aufnahme.
        try:
            groesse = os.path.getsize(aufnahme)
        except OSError:
            groesse = 0
        kurz = groesse < KURZ_GRENZE
        if groesse < STILLE_GRENZE:
            # Reine Stille — der Anrufer denkt nach oder holt Luft. Da gehoert
            # KEIN Fuellwort hin, das wirkt hektisch und faellt ins Wort.
            # (Asterisk schneidet die Nachlaufstille weg; bleibt fast nichts
            # uebrig, wurde auch fast nichts gesagt.)
            pass
        elif kurz:
            spiele("/var/lib/asterisk/sounds/v3d/kurz%d" % ((runde * 2) % 5 + 1))
        else:
            spiele("/var/lib/asterisk/sounds/v3d/fueller%d" % ((runde * 3) % 8 + 1))
        faden.join(timeout=60)

        if "fehler" in kasten or "antwort" not in kasten:
            sag("V3D Dialog Fehler: %s" % kasten.get("fehler", "Zeitueberschreitung"))
            return rueckfall(cid)
        antw = kasten["antwort"]

        if antw.get("zoegern"):
            # Der Anrufer hat nur "aehm" gemacht und ueberlegt noch. Nicht
            # nachhaken — einfach still weiter zuhoeren, sonst wirkt der
            # Assistent hektisch und faellt dem Anrufer ins Wort.
            zoegern_hintereinander += 1
            if zoegern_hintereinander >= 4:
                break
            continue
        zoegern_hintereinander = 0

        if antw.get("leer"):
            leer_hintereinander += 1
            if leer_hintereinander >= 3:
                break
            if not spiele("/var/lib/asterisk/sounds/v3d/nachfrage"):
                return
            continue
        leer_hintereinander = 0

        sag("V3D Runde %d: %s" % (runde, (antw.get("frage") or "")[:80]))
        datei = antw.get("antwortDatei")
        if datei and not spiele(datei):
            return
        if antw.get("fehler"):
            sag("V3D Dialog Fehler: %s" % antw["fehler"])
            return rueckfall(cid)
        if antw.get("ende"):
            break

    spiele("/var/lib/asterisk/sounds/v3d/danke")
    agi("HANGUP")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        try:
            sag("V3D AGI Ausnahme: %s" % e)
        except Exception:
            pass
