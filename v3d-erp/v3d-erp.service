[Unit]
Description=V3D ERP Prototyp (nur Tailnet)
After=network-online.target
# nach einem Rechner-Neustart nie endgültig aufgeben (Tailscale-Adresse kommt evtl. später)
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/home/v3da/v3d-erp
Environment=V3D_ERP_HOST=100.125.34.44
ExecStart=/home/v3da/v3d-erp/.venv/bin/python /home/v3da/v3d-erp/server.py 8820
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
