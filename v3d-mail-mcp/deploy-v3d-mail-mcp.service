[Unit]
Description=V3D Mail MCP-Connector für Claude (Port 8802, nur 127.0.0.1)
After=network-online.target volmemail.service

[Service]
ExecStart=/home/v3da/v3d-mail-mcp/bin/v3d-mail-mcp serve
WorkingDirectory=/home/v3da/v3d-mail-mcp
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
