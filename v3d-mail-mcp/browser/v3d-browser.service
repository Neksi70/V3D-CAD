[Unit]
Description=V3D Browser: Playwright MCP für den V3D-Mail-Connector (127.0.0.1:8812)
Requires=v3d-browser-proxy.service
After=v3d-browser-proxy.service

[Service]
WorkingDirectory=/home/v3da/.local/share/v3d-browser/arbeit
ExecStart=/usr/bin/env node /home/v3da/v3d-mail-mcp/browser/node_modules/@playwright/mcp/cli.js --config /home/v3da/v3d-mail-mcp/browser/config.json --headless --block-service-workers --idle-timeout 1800000 --allowed-hosts 127.0.0.1:8812
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
