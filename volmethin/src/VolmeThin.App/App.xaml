<Application x:Class="VolmeThin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Flaeche" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="Rand" Color="#FFD8DDE4" />
    <SolidColorBrush x:Key="Akzent" Color="#FF1F6FEB" />
    <SolidColorBrush x:Key="Gedimmt" Color="#FF6B7280" />

    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
    <Style x:Key="Feldname" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style x:Key="Hinweis" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Gedimmt}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Application.Resources>
</Application>
