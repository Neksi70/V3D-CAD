[Unit]
Description=V3D Druck-Waechter (stoppt haengende Drucke automatisch)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/orca-wasm/bridge
ExecStart=/usr/bin/node /home/v3da/orca-wasm/bridge/print-watchdog.js
Environment=WATCHDOG_POLL_S=60
Environment=WATCHDOG_HANG_MIN=15
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
