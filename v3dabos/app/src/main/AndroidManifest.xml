<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Nutzungsdaten: Sonderberechtigung, die der Nutzer selbst in den Systemeinstellungen
      erteilt (Einstellungen -> Apps -> Spezieller App-Zugriff -> Nutzungsdaten).
      Ohne sie laeuft die App, kann aber nicht sagen, welches Abo brachliegt.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Erinnerung an Kuendigungsfristen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      KEINE Internet-Berechtigung: alle Daten bleiben auf dem Geraet. Play-Store- und
      Anbieterseiten werden an den Browser bzw. den Play Store weitergereicht.
    -->

    <!-- Erlaubt, installierte Apps mit Starter-Symbol zu sehen (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.V3DAbos">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".EditActivity" android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ScanActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".ImportActivity" android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".KuendigenActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".EinstellungenActivity" android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
