[Unit]
Description=V3D Schichthöhe — adaptive Schichthöhe als 3MF für Studio/Orca/Prusa (Port 8798)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dschichten
ExecStart=/usr/bin/python3 /home/v3da/v3dschichten/server.py 8798
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
