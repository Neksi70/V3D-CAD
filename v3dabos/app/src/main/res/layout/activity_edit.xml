<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Name des Abos">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Anbieter (für das Kündigungsschreiben)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAnbieter"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="Betrag in €">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBetrag"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner android:id="@+id/spIntervall"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textStyle="bold" android:text="Laufzeit" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnNaechste"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Nächste Zahlung: —" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnBeginn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Vertragsbeginn: —" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="Frist (Tage)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFrist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_height="wrap_content" android:hint="Mindestlaufzeit (Mon.)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLaufzeit"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textStyle="bold"
            android:text="Nutzung messen" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:alpha="0.75"
            android:text="V3D Abos misst, wie lange die verknüpfte App im Vordergrund war. Ohne App (z. B. Zeitung, Fitnessstudio) bleibt die Bewertung gelb." />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnApp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="App wählen: keine" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textStyle="bold" android:text="Kündigungsweg" />

        <Spinner android:id="@+id/spWeg"
            android:layout_width="match_parent" android:layout_height="56dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Kündigungsseite (URL)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUrl"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="E-Mail für die Kündigung">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:hint="Kundennummer">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etKunde"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_height="wrap_content" android:hint="Vertragsnummer">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etVertrag"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Notiz">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNotiz"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textMultiLine" android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:id="@+id/tvStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:textSize="14sp" android:visibility="gone" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnKuendigen"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Dieses Abo kündigen" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnLoeschen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="24dp"
            android:textColor="@color/ampel_rot" android:text="Aus der Liste löschen" />
    </LinearLayout>
</ScrollView>
