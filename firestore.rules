rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Gespeicherte Designs — nur der eigene Nutzer
    match /users/{uid}/designs/{designId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Kurs-/Tutorial-Fortschritt — nur der eigene Nutzer
    match /users/{uid}/progress/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Abstimmungen — oeffentlich lesbar; jeder darf abstimmen (Stimmen-Zaehler),
    // aber Frage/Optionen/Besitzer duerfen nicht veraendert werden.
    // Erstellen nur angemeldet; loeschen nur der Ersteller.
    // Geteilte 3D-Modelle (read-only Link) — oeffentlich lesbar; erstellen nur
    // angemeldet, loeschen nur der Ersteller. Inhalt unveraenderlich.
    match /shared/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }

    // ── Gemeinsame Sitzungen (zu zweit am selben Modell) ──────────────
    // Gastgeber und Gast arbeiten abwechselnd; wer den "Stift" hat, schreibt
    // den Stand nach state/doc. Der Gast braucht bewusst KEIN Konto — der
    // Link ist der Schluessel. Entsprechend gilt: wer den Link hat, darf in
    // der Sitzung aendern.
    //
    // Durchgesetzt wird hier:
    //   1. die Sitzungs-ID ist zufaellig und unratbar (der eigentliche Schutz)
    //   2. expiresAt — abgelaufen heisst weder lesbar noch schreibbar
    //   3. Eigentuemer, Code und Ablauf sind unveraenderlich: niemand kann
    //      die Sitzung kapern oder heimlich verlaengern
    // Der vorgelesene Code wird im Client geprueft; im Doc liegt nur sein
    // SHA-256-Hash, nie der Klartext.
    //
    // Was hier NICHT passiert: das gespeicherte Design des Gastgebers
    // anfassen. Die Sitzung ist eine Arbeitskopie, Speichern bleibt bei ihm.
    match /sessions/{sid} {
      allow read: if resource != null && resource.data.expiresAt > request.time.toMillis();
      allow create: if request.auth != null
                    && request.resource.data.host == request.auth.uid
                    && request.resource.data.expiresAt <= request.time.toMillis() + 86400000;
      allow update: if resource != null
                    && resource.data.expiresAt > request.time.toMillis()
                    && request.resource.data.host == resource.data.host
                    && request.resource.data.codeHash == resource.data.codeHash
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt;
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;

      // Der gemeinsame Stand (state/doc). Schreiben darf, wer in der Sitzung
      // ist — wer gerade dran ist, klaert der Staffelstab im Client.
      // Bewusst ohne get() auf das Eltern-Doc: das waere ein zusaetzlicher
      // Lesevorgang bei jedem einzelnen Schreiben.
      match /state/{docId} {
        allow read: if resource != null && resource.data.expiresAt > request.time.toMillis();
        allow create, update: if request.resource.data.expiresAt > request.time.toMillis()
                              && request.resource.data.expiresAt <= request.time.toMillis() + 86400000;
        allow delete: if true;
      }

      // Kamera je Teilnehmer, damit man einander folgen kann.
      match /cams/{camId} {
        allow read: if true;
        allow create, update: if request.resource.data.expiresAt > request.time.toMillis()
                              && request.resource.data.expiresAt <= request.time.toMillis() + 86400000;
        allow delete: if true;
      }

      // Markierungen der Zuschauer ("schau mal hier"). Anonym erlaubt, weil
      // der Betreuer sich nicht anmelden muss; Missbrauch setzt Kenntnis der
      // unratbaren Sitzungs-ID voraus und endet mit der Sitzung.
      match /marks/{markId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['p','t','at','by','expiresAt'])
                      && request.resource.data.p.size() == 3
                      && request.resource.data.t is string
                      && request.resource.data.t.size() <= 80
                      && request.resource.data.by is string
                      && request.resource.data.by.size() <= 40;
        allow update: if false;
        allow delete: if true;   // Gastgeber raeumt auf, Zuschauer nimmt seinen zurueck
      }

      // Anwesenheit: jeder Zuschauer haelt ein Doc mit Zeitstempel frisch,
      // damit der Gastgeber sieht, dass wirklich jemand mitguckt.
      match /eyes/{viewerId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['at','name'])
                              && request.resource.data.at is number;
        allow delete: if true;
      }
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.resource.data.question == resource.data.question
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.options.size() == resource.data.options.size();
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }
  }
}
