<Window x:Class="VolmeThin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolmeThin - Anwendungen einpacken" Height="720" Width="900"
        Background="{StaticResource Flaeche}" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopf -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Anwendung einpacken" FontSize="22" FontWeight="Bold" />
      <TextBlock x:Name="TxtSchritt" Style="{StaticResource Hinweis}"
                 Text="Schritt 1 von 3 - Aufnehmen" Margin="0,2,0,0" />
      <Border Height="1" Background="{StaticResource Rand}" Margin="0,8,0,0" />
    </StackPanel>

    <!-- Schritt 1: Aufnehmen -->
    <StackPanel x:Name="PanelAufnehmen" Grid.Row="1">
      <TextBlock Style="{StaticResource Hinweis}" TextWrapping="Wrap">
        VolmeThin merkt sich den Zustand des Rechners, laesst dann die Installation laufen und
        vergleicht danach erneut. Alles, was neu dazugekommen ist, wird zum Paket.
        Am saubersten wird das Ergebnis auf einem frisch aufgesetzten Rechner ohne offene Programme.
      </TextBlock>

      <Border BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,10" Background="White">
        <StackPanel>
          <TextBlock Text="1. Zustand vor der Installation aufnehmen" Style="{StaticResource Feldname}" />
          <TextBlock Style="{StaticResource Hinweis}" Text="Dauert je nach Rechner ein bis fuenf Minuten." />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnVorher" Content="Vorher aufnehmen" Click="BtnVorher_Click" />
            <TextBlock x:Name="TxtVorher" VerticalAlignment="Center" Foreground="{StaticResource Gedimmt}" Text="noch nicht aufgenommen" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10" Background="White">
        <StackPanel>
          <TextBlock Text="2. Anwendung installieren" Style="{StaticResource Feldname}" />
          <TextBlock Style="{StaticResource Hinweis}"
                     Text="Setup ganz normal durchklicken. Danach das Programm einmal starten und wieder schliessen, damit auch die Ersteinrichtung mit ins Paket wandert." />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnInstaller" Content="Setup auswaehlen ..." Click="BtnInstaller_Click" IsEnabled="False" />
            <TextBlock x:Name="TxtInstaller" VerticalAlignment="Center" Foreground="{StaticResource Gedimmt}"
                       Text="oder das Setup einfach selbst starten" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="6" Padding="14" Background="White">
        <StackPanel>
          <TextBlock Text="3. Zustand nach der Installation aufnehmen" Style="{StaticResource Feldname}" />
          <TextBlock Style="{StaticResource Hinweis}" Text="Vergleicht beide Aufnahmen und sammelt die Unterschiede ein." />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnNachher" Content="Nachher aufnehmen" Click="BtnNachher_Click" IsEnabled="False" />
            <TextBlock x:Name="TxtNachher" VerticalAlignment="Center" Foreground="{StaticResource Gedimmt}" Text="" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Schritt 2: Pruefen -->
    <Grid x:Name="PanelPruefen" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource Feldname}" />
          <TextBox x:Name="TbName" />
          <TextBlock Text="Kennung (Ordnername im Zwischenspeicher)" Style="{StaticResource Feldname}" />
          <TextBox x:Name="TbId" />
          <TextBlock Text="Version" Style="{StaticResource Feldname}" />
          <TextBox x:Name="TbVersion" Text="1.0.0" />
          <TextBlock Text="Hersteller" Style="{StaticResource Feldname}" />
          <TextBox x:Name="TbHersteller" />

          <TextBlock Text="Startdatei" Style="{StaticResource Feldname}" />
          <ComboBox x:Name="CbStart" IsEditable="True" />

          <TextBlock Text="Ablage auf dem Zielrechner" Style="{StaticResource Feldname}" />
          <ComboBox x:Name="CbModus" SelectedIndex="0">
            <ComboBoxItem Content="Installieren (Originalpfade, braucht Adminrechte)" Tag="install" />
            <ComboBoxItem Content="Portabel (Zwischenspeicher im Benutzerprofil)" Tag="portable" />
          </ComboBox>

          <CheckBox x:Name="ChkCleanup" Content="Nach dem Beenden wieder aufraeumen" Margin="0,4,0,10" />
          <CheckBox x:Name="ChkWait" Content="Starter bleibt bis zum Programmende offen" IsChecked="True" Margin="0,0,0,10" />

          <Border Background="White" BorderBrush="{StaticResource Rand}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
              <TextBlock Text="Aufgenommen" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock x:Name="TxtBilanz" Style="{StaticResource Hinweis}" Margin="0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <DockPanel Grid.Column="1">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="Gefundene Dateien" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox x:Name="TbFilter" Width="220" Margin="0" TextChanged="TbFilter_TextChanged"
                   ToolTip="Liste durchsuchen" />
          <Button Content="Auswahl entfernen" Click="BtnEntfernen_Click" Margin="12,0,0,0" MinWidth="0" Padding="10,4" />
        </StackPanel>
        <ListBox x:Name="LstDateien" SelectionMode="Extended" FontFamily="Consolas" FontSize="11"
                 VirtualizingPanel.IsVirtualizing="True" />
      </DockPanel>
    </Grid>

    <!-- Schritt 3: Bauen -->
    <StackPanel x:Name="PanelBauen" Grid.Row="1" Visibility="Collapsed">
      <TextBlock Style="{StaticResource Hinweis}"
                 Text="Aus dem Paket entsteht jetzt eine einzelne EXE. Die traegt alles in sich: Doppelklick auf dem Kurs-PC genuegt." />

      <TextBlock Text="Zieldatei" Style="{StaticResource Feldname}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Waehlen ..." Click="BtnZiel_Click" MinWidth="0" Padding="12,4" Margin="8,2,0,10" />
        <TextBox x:Name="TbZiel" />
      </DockPanel>

      <TextBlock Text="Symbol (optional, sonst wird das der Startdatei genommen)" Style="{StaticResource Feldname}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Waehlen ..." Click="BtnIcon_Click" MinWidth="0" Padding="12,4" Margin="8,2,0,10" />
        <TextBox x:Name="TbIcon" />
      </DockPanel>

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="BtnBauen" Content="EXE bauen" Click="BtnBauen_Click" FontWeight="Bold" />
        <Button x:Name="BtnOrdner" Content="Ordner oeffnen" Click="BtnOrdner_Click" IsEnabled="False" />
      </StackPanel>
    </StackPanel>

    <!-- Protokoll -->
    <Expander Grid.Row="2" Header="Protokoll" Margin="0,12,0,8">
      <TextBox x:Name="TbProtokoll" Height="120" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
               VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,6,0,0" />
    </Expander>

    <!-- Fuss -->
    <Grid Grid.Row="3">
      <ProgressBar x:Name="Fortschritt" Height="6" VerticalAlignment="Top" Margin="0,0,0,10" Maximum="1000" />
      <DockPanel Margin="0,16,0,0">
        <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="{StaticResource Gedimmt}" Text="Bereit." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
          <Button x:Name="BtnZurueck" Content="Zurueck" Click="BtnZurueck_Click" IsEnabled="False" />
          <Button x:Name="BtnWeiter" Content="Weiter" Click="BtnWeiter_Click" IsEnabled="False" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
