[Unit]
Description=V3D Antwort — WhatsApp-Antworten mit Terminvorschlaegen (Port 8821)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dantwort
ExecStart=/usr/bin/python3 /home/v3da/v3dantwort/server.py
Environment=PATH=/home/v3da/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
