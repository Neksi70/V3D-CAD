[Unit]
Description=V3D Druckcheck — Slicer-Einstellungen prüfen und verbessern (Port 8810)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3ddruckcheck
ExecStart=/usr/bin/python3 /home/v3da/v3ddruckcheck/server.py 8810
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
