[Unit]
Description=V3D CAD claude.ai-Connector (Port 8840, nur 127.0.0.1)
After=network-online.target volme3d.service v3d-cad-agent-hub.service

[Service]
User=v3da
ExecStart=/home/v3da/v3d-cad-connector/bin/v3d-cad-connector serve
WorkingDirectory=/home/v3da/v3d-cad-connector
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
