[Unit]
Description=V3D Kristall — 2D-Foto zu 3D-Punktwolke für K9-Glaslaser (Port 8799)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dkristall
ExecStart=/usr/bin/python3 /home/v3da/v3dkristall/server.py 8799
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
