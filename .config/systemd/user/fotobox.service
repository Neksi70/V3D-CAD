[Unit]
Description=Fotobox-Portal — Eltern-Galerie mit Registrierung (Port 8788)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/fotobox
ExecStart=/usr/bin/node /home/v3da/fotobox/server.js 8788
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
