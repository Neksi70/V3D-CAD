<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="V3D Handy" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Claude steuert dieses Handy über den V3D-Server — wie „Claude in Chrome“, nur fürs Handy."
            android:textColor="@color/text2" android:layout_marginTop="4dp" android:layout_marginBottom="20dp"/>

        <TextView android:id="@+id/zustand" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/karte" android:padding="14dp" android:textSize="15sp"
            android:text="Verbindung aus" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1. Bedienungshilfe" android:textStyle="bold" android:textColor="@color/text" android:textSize="16sp"/>
        <TextView android:id="@+id/bedienhilfe" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="…" android:layout_marginTop="4dp"/>
        <Button android:id="@+id/bedienhilfeKnopf" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Bedienungshilfen öffnen" android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2. Server" android:textStyle="bold" android:textColor="@color/text" android:textSize="16sp"/>
        <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Server-Adresse" android:inputType="textUri" android:layout_marginTop="4dp"/>
        <EditText android:id="@+id/schluessel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Geräte-Schlüssel (aus config.json auf dem Server)" android:inputType="textVisiblePassword"/>
        <Button android:id="@+id/speichern" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Speichern" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="3. Verbindung" android:textStyle="bold" android:textColor="@color/text" android:textSize="16sp"/>
        <Switch android:id="@+id/schalter" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fernsteuerung durch Claude erlauben" android:textColor="@color/text"
            android:layout_marginTop="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Solange der Schalter an ist, zeigt eine Benachrichtigung „Fernsteuerung an“ mit Stopp-Knopf. Ausschalten beendet sofort alles."
            android:textColor="@color/text2" android:textSize="13sp" android:layout_marginBottom="16dp"/>
        <Button android:id="@+id/akku" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Akku-Optimierung für diese App aus"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sonst kappt Android im Ruhezustand die Verbindung."
            android:textColor="@color/text2" android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
