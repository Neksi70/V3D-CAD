[Unit]
Description=V3D Agent (WhatsApp-Bruecke zu Claude Code)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dagent
ExecStart=/usr/bin/python3 /home/v3da/v3dagent/agent.py
Environment=PATH=/home/v3da/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
