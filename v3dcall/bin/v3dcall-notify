#!/bin/sh
# Wird von Asterisk beim Auflegen aufgerufen und meldet den Anruf
# an den V3D-Dienst auf 127.0.0.1:8786.
#   $1 = Anruf-ID   $2 = Rufnummer   $3 = Name   $4 = Aufnahmedatei
#
# Der geteilte Token liegt in /etc/v3dcall.token (nur root:asterisk lesbar).
# Ohne ihn lehnt der Dienst die Meldung ab — das schuetzt den Endpunkt,
# weil hinter dem Tailscale-Funnel jeder Zugriff wie "localhost" aussieht.
[ -z "$1" ] && exit 0
TOKEN=""
[ -r /etc/v3dcall.token ] && TOKEN="$(cat /etc/v3dcall.token)"
exec /usr/bin/curl -s -m 10 -o /dev/null \
  -X POST http://127.0.0.1:8786/api/incoming \
  -H "X-V3D-Notify: $TOKEN" \
  --data-urlencode "id=$1" \
  --data-urlencode "caller=$2" \
  --data-urlencode "name=$3" \
  --data-urlencode "file=$4"
