# Weboberflaeche von VolmeStick als Nutzer-Dienst.
#   cp volmestick.service ~/.config/systemd/user/
#   systemctl --user enable --now volmestick
# ACHTUNG: nur im Heimnetz/Tailnet anbieten, nie im Funnel.
[Unit]
Description=VolmeStick - Windows-Medien bauen
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/volmestick
ExecStart=/usr/bin/python3 %h/volmestick/server.py --port 8775 --host 0.0.0.0
Restart=on-failure

[Install]
WantedBy=default.target
