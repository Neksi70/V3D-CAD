<?xml version="1.0" encoding="utf-8"?>
<!-- Klartext nur zum Emulator-Host und ins Tailnet (V3DA direkt); alles andere nur HTTPS -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">100.125.34.44</domain>
        <domain includeSubdomains="false">v3da</domain>
    </domain-config>
</network-security-config>
