#!/bin/bash
# Code-Modus der Anrufannahme: Verifizierungsanruf (Meta, Google, Bank ...) ohne
# Ansage und Assistent mitschneiden. Der Code kommt als Text + Audio per Mail.
#   codemodus an [Minuten]   (Standard 20, schaltet sich danach selbst ab)
#   codemodus aus
#   codemodus                (Status)
FLAG=/var/spool/v3dcall/codemodus
case "${1:-}" in
  an)
    MIN="${2:-20}"
    touch "$FLAG" && echo "Code-Modus AN für $MIN Minuten – Anruf an 02331 7397112 wird nur aufgezeichnet."
    nohup bash -c "sleep $((MIN*60)); rm -f '$FLAG'" >/dev/null 2>&1 &
    ;;
  aus)
    rm -f "$FLAG" && echo "Code-Modus AUS – Assistent geht wieder ran."
    ;;
  *)
    [ -e "$FLAG" ] && echo "Code-Modus ist AN (seit $(stat -c %y "$FLAG" | cut -c1-16))" || echo "Code-Modus ist aus."
    ;;
esac
