[Unit]
Description=V3D Anrufannahme — Nachrichten annehmen, verschriftlichen, zustellen (Port 8786)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dcall
ExecStart=/home/v3da/v3dcall/.venv/bin/python /home/v3da/v3dcall/server.py 8786
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
