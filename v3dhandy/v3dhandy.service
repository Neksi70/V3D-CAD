[Unit]
Description=V3D Handy — Handy-Fernsteuerung fuer Claude (Port 8794)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dhandy
ExecStart=/usr/bin/python3 /home/v3da/v3dhandy/server.py 8794
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
