[Unit]
Description=V3D CAD Agent-Hub (Live-Tabs + Monitor, Port 8830, nur 127.0.0.1)
After=network-online.target volme3d.service

[Service]
User=v3da
Environment=V3D_CONNECTOR_URL=https://v3dcad.volme3dakademie.de/cad-mcp/mcp
Environment=V3D_MONITOR_ORIGIN=https://v3dcad.volme3dakademie.de
ExecStart=/usr/bin/env node /home/v3da/v3d-cad-mcp/server.mjs --hub
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
