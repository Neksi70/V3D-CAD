<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:id="@+id/tvKopf"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" />

        <TextView android:id="@+id/tvErsparnis"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:layout_marginTop="2dp"
            android:textColor="@color/ampel_gruen" />

        <TextView android:id="@+id/tvFrist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:layout_marginTop="6dp" android:alpha="0.85" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textStyle="bold" android:text="1. Über Google Play gekauft?" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:alpha="0.8" android:layout_marginTop="2dp"
                    android:text="Läuft das Abo über den Play Store, geht die Kündigung nur dort – ein Klick, sofort wirksam zum Ende des bezahlten Zeitraums." />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnPlay"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Play-Abo öffnen" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textStyle="bold" android:text="2. Beim Anbieter kündigen" />

                <TextView android:id="@+id/tvUrl"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:alpha="0.8" android:layout_marginTop="2dp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnWeb"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Kündigungsseite öffnen" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textStyle="bold" android:text="3. Kündigungsschreiben" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:alpha="0.8" android:layout_marginTop="2dp"
                    android:text="Fertiger Text in Textform (§ 126b BGB) – vor dem Senden prüfen und ergänzen." />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minLines="8" android:gravity="top|start"
                        android:textSize="13sp" android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMail"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="E-Mail" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTeilen"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content" android:text="Teilen" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnKopieren"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content" android:text="Kopieren" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:text="Erledigt?" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:alpha="0.8"
            android:text="V3D Abos kann nicht für dich kündigen – das lässt Android nicht zu. Sobald du gekündigt hast, hier markieren: das Abo wandert grau nach unten und zählt nicht mehr zur Monatssumme." />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnEnde"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Vertragsende: unbekannt" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnMarkieren"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:text="Als gekündigt markieren" />
    </LinearLayout>
</ScrollView>
