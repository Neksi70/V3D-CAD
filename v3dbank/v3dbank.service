[Unit]
Description=V3D Bank — Kontostände und Umsätze bunq/Revolut/SumUp (Port 8801, nur Tailnet)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/v3da/v3dbank
ExecStart=/usr/bin/python3 /home/v3da/v3dbank/server.py
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
